{
  "imports": {
    "react": "npm:react@^19",
    "react/jsx-runtime": "npm:react@^19/jsx-runtime",
    "react-dom/client": "npm:react-dom@^19/client"
  },
  "tasks": {
    "install": {
      "description": "Install Deno dependencies.",
      "command": "deno install --quiet"
    },
    "update": {
      "description": "Update Deno dependencies.",
      "command": "deno outdated --update --compatible"
    }
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "npm:@types/react@^19"
    ],
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns"
    ]
  }
}
